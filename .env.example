# Copy to `.env` and fill in. `.env` is git-ignored.
#
# Polymarket US API key (only required for authenticated endpoints like
# order placement). The scanner's read path — events, order book,
# settlement — hits public gateway endpoints and does NOT need these
# set. Leave blank unless/until live trading is wired up.
#
# Get keys at: https://polymarket.us (Developer API section).
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET=
