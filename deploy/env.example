# Copy to ~/Arbitrage_Betting/.env on the VPS.
# systemd reads this via EnvironmentFile= in each unit.

# Pinnacle public API key. Required — poller exits on startup without it.
PINNACLE_API_KEY=

# Prop ingestion (matches your local setup).
PINNACLE_INCLUDE_PROPS=1
KALSHI_INCLUDE_PROPS=1

# Dashboard bind host. 0.0.0.0 lets Tailscale peers reach it;
# ufw continues to block the public WAN port.
EV_DASHBOARD_HOST=0.0.0.0

# Optional overrides. Defaults shown.
# PROP_MIN_EDGE=4.0
# PAPER_INCLUDE_PROPS=0
# LADDER_FETCH_TIMEOUT_SEC=5.0

# ---- Real-money trading (optional; off until both adapters are validated) ----
# Master switch. real_tracker only transmits orders when this is "1".
# Leave at "0" until KALSHI_* and POLYMARKET_US_* are populated and the
# polymarket trade adapter (adapters/polymarket_trade.py) has a working POC.
REAL_TRADING_ENABLED=0

# Kalshi auth — RSA-PSS signing.
# KALSHI_API_KEY:     UUID issued by Kalshi.
# KALSHI_PRIVATE_KEY: base64-encoded PEM, single line. systemd's EnvironmentFile
#                     can't parse multi-line values, so embed the b64 form.
# Generate with:      base64 -i your_pem_file | tr -d '\n'
# Alternative:        set KALSHI_PRIVATE_KEY_PATH to a file path instead.
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY=

# Polymarket US auth — Ed25519 signing per docs.polymarket.us.
# POLYMARKETUS_API_KEY:     Key ID from polymarket.us/developer.
# POLYMARKETUS_PRIVATE_KEY: Secret key (base64) shown once at key-creation time.
POLYMARKETUS_API_KEY=
POLYMARKETUS_PRIVATE_KEY=

# Optional. Defaults shown.
# REAL_INCLUDE_PROPS=0
# REAL_DAILY_LOSS_HALT_USD=-100.0
# REAL_PER_BET_HARD_CAP_USD=30.0
