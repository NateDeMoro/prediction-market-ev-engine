[Unit]
Description=Kalshi snapshot poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arb
Group=arb
WorkingDirectory=/home/arb/Arbitrage_Betting
EnvironmentFile=/home/arb/Arbitrage_Betting/.env
ExecStart=/usr/bin/python3 /home/arb/Arbitrage_Betting/kalshi_poller.py
Restart=on-failure
RestartSec=10s
StandardOutput=append:/home/arb/Arbitrage_Betting/data/kalshi.stdout.log
StandardError=append:/home/arb/Arbitrage_Betting/data/kalshi.stderr.log

[Install]
WantedBy=multi-user.target
