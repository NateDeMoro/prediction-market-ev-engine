[Unit]
Description=Pinnacle snapshot poller
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=arb
Group=arb
WorkingDirectory=/home/arb/Arbitrage_Betting
EnvironmentFile=/home/arb/Arbitrage_Betting/.env
ExecStart=/usr/bin/python3 /home/arb/Arbitrage_Betting/pinnacle_poller.py
Restart=on-failure
RestartSec=10s
MemoryMax=512M
LimitNOFILE=4096
StandardOutput=append:/home/arb/Arbitrage_Betting/data/pinnacle.stdout.log
StandardError=append:/home/arb/Arbitrage_Betting/data/pinnacle.stderr.log

[Install]
WantedBy=multi-user.target
