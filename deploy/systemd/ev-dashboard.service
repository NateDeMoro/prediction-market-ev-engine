[Unit]
Description=EV dashboard (Flask) + paper tracker
After=network-online.target pinnacle-poller.service kalshi-poller.service
Wants=network-online.target

[Service]
Type=simple
User=arb
Group=arb
WorkingDirectory=/home/arb/Arbitrage_Betting
EnvironmentFile=/home/arb/Arbitrage_Betting/.env
ExecStart=/usr/bin/python3 /home/arb/Arbitrage_Betting/ev_dashboard.py
Restart=on-failure
RestartSec=10s
StandardOutput=append:/home/arb/Arbitrage_Betting/data/dashboard.stdout.log
StandardError=append:/home/arb/Arbitrage_Betting/data/dashboard.stderr.log

[Install]
WantedBy=multi-user.target
