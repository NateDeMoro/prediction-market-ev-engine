[Unit]
Description=EV dashboard (Flask) + paper tracker
After=network-online.target pinnacle-poller.service kalshi-poller.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=arb
Group=arb
WorkingDirectory=/home/arb/Arbitrage_Betting
EnvironmentFile=/home/arb/Arbitrage_Betting/.env
ExecStart=/usr/bin/python3 /home/arb/Arbitrage_Betting/ev_dashboard.py
Restart=on-failure
RestartSec=10s
MemoryMax=1G
LimitNOFILE=4096
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
