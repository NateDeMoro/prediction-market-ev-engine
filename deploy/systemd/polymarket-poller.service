[Unit]
Description=Polymarket snapshot poller
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=arb
Group=arb
WorkingDirectory=/home/arb/Arbitrage_Betting
EnvironmentFile=/home/arb/Arbitrage_Betting/.env
ExecStart=/usr/bin/python3 /home/arb/Arbitrage_Betting/polymarket_poller.py
Restart=on-failure
RestartSec=10s
MemoryMax=512M
LimitNOFILE=4096
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
